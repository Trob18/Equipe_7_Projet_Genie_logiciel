<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app_icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasySave.Log\EasySave.Log.csproj" />
  </ItemGroup>

  <Target Name="BuildCryptoSoft" BeforeTargets="BeforeBuild">
    <MSBuild Projects="..\CryptoSoft\CryptoSoft.csproj" Targets="Build" />
  </Target>

</Project>
