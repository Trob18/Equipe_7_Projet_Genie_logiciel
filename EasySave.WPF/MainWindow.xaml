<Window x:Class="EasySave.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.WPF"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:EasySave.WPF.Enumerations"
        mc:Ignorable="d"
        Title="EasySave v3.0" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F9">

    <Window.Resources>
        <!-- Enumerations -->
        <ObjectDataProvider x:Key="BackupTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BackupType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="LanguageEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Language"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Styles -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34495E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F618D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#E5E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="SettingsDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#2C3E50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="25,40,25,40" Orientation="Horizontal">
                <TextBlock Text="🛡️" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="EasySave" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <RadioButton Content="📂  Backups" Style="{StaticResource SidebarButtonStyle}" 
                             IsChecked="True" x:Name="BackupsNavBtn"/>
                <RadioButton Content="⚙️  Settings" Style="{StaticResource SidebarButtonStyle}"
                             x:Name="SettingsNavBtn"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="v3.0.0" Foreground="#7F8C8D" Margin="25" FontSize="10"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" BorderBrush="#ECF0F1" BorderThickness="0,0,0,1">
                <Grid Margin="25,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#7F8C8D" VerticalAlignment="Center" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="+ Create Job" Command="{Binding OpenCreateJobCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Backups View -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BackupsNavBtn}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="JobsDataGrid" ItemsSource="{Binding BackupJobs}" SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="DataGrid_SelectionChanged"
                          BorderThickness="0" Background="Transparent" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="60">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#95A5A6"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#ECF0F1"/>
                            <Setter Property="Height" Value="40"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#F2F8FD"/>
                                    <Setter Property="BorderBrush" Value="#2980B9"/>
                                    <Setter Property="BorderThickness" Value="1,0,0,0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="Job Name" Width="180" FontWeight="SemiBold" Foreground="#2C3E50"/>
                        <DataGridTemplateColumn Header="Directories" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceDirectory}" FontSize="11" Foreground="#34495E" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TargetDirectory}" FontSize="10" Foreground="#95A5A6" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding Type}" Header="Type" Width="80"/>
                        <DataGridTemplateColumn Header="Progress" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,4"/>
                                        <ProgressBar Value="{Binding Progress}" Grid.Row="1" Height="6" Background="#ECF0F1" BorderThickness="0">
                                            <ProgressBar.Foreground><SolidColorBrush Color="#2980B9"/></ProgressBar.Foreground>
                                        </ProgressBar>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20" Margin="0,20,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Selected Jobs: " VerticalAlignment="Center" Foreground="#7F8C8D"/>
                            <TextBlock Text="{Binding SelectedJobsList.Count}" FontWeight="Bold" VerticalAlignment="Center" Foreground="#2C3E50" Margin="5,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Delete" Command="{Binding DeleteJobCommand}" Style="{StaticResource DangerButtonStyle}" Width="100" Margin="0,0,10,0"/>
                            <Button Content="Run Backup" Command="{Binding ExecuteJobCommand}" Style="{StaticResource ActionButtonStyle}" Width="150"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- NEW Settings View -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SettingsNavBtn}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                        
                        <!-- Header & Search -->
                        <Grid Margin="0,0,0,30">
                            <TextBlock Text="Settings" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                            <!-- <TextBox Width="250" HorizontalAlignment="Right" Padding="10,6" Tag="Search settings..." BorderBrush="#D5DBDB"/> -->
                        </Grid>

                        <!-- SECTION: GENERAL -->
                        <TextBlock Text="Application" Foreground="#95A5A6" FontWeight="Bold" FontSize="12" Margin="5,0,0,10"/>
                        
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Language" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="Changes will apply after restarting the application" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180" Height="32" ItemsSource="{Binding Source={StaticResource LanguageEnum}}" SelectedItem="{Binding SelectedLanguage}"/>
                                </Grid>
                                
                                <Separator Background="#F2F4F4" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Logging Format" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="Select your preferred file format for logs" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="180" Height="32" ItemsSource="{Binding LogFormats}" SelectedItem="{Binding SelectedLogFormat}"/>
                                </Grid>

                                <Separator Background="#F2F4F4" Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Log Server IP" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="Enter IP address for remote logging via NetworkLogger" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180" Height="32" VerticalContentAlignment="Center" Padding="8,0" Text="{Binding LogServerIP, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION: ENCRYPTION & BUSINESS -->
                        <TextBlock Text="Backup &amp; Security" Foreground="#95A5A6" FontWeight="Bold" FontSize="12" Margin="5,15,0,10"/>

                        <!-- Encrypted Extensions -->
                        <Border Style="{StaticResource CardStyle}">
                            <Expander Background="Transparent" BorderThickness="0">
                                <Expander.Header>
                                    <Grid Width="600">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔒" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Encrypted Extensions" Style="{StaticResource SettingsTitleStyle}"/>
                                                <TextBlock Text="Manage file types to encrypt during backup" Style="{StaticResource SettingsDescStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding EncryptedExtensionsList.Count}" HorizontalAlignment="Right" Foreground="#2980B9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="10,20,10,10">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExtInput" Text="{Binding NewExtensionInput, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Tag="Add extensions (.txt, .pdf...)" BorderBrush="#D5DBDB"/>
                                        <Button Grid.Column="1" Content="Add Extension" Command="{Binding AddExtensionCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Width="130"/>
                                    </Grid>

                                    <Border BorderBrush="#F2F4F4" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                                        <StackPanel>
                                            <TextBox Margin="1" Padding="10,5" BorderThickness="0,0,0,1" BorderBrush="#F2F4F4" Background="White" Text="{Binding ExtensionsSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Filter extensions..."/>
                                            <ListBox ItemsSource="{Binding FilteredExtensions}" MaxHeight="150" BorderThickness="0" Background="Transparent" Padding="5">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="5,2">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
                                                            <Button Grid.Column="1" Content="Remove" Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <!-- Blocked Processes -->
                        <Border Style="{StaticResource CardStyle}">
                            <Expander Background="Transparent" BorderThickness="0">
                                <Expander.Header>
                                    <Grid Width="600">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🚫" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Blocked Processes" Style="{StaticResource SettingsTitleStyle}"/>
                                                <TextBlock Text="Backups will pause if these processes are running" Style="{StaticResource SettingsDescStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BlockedProcessesList.Count}" HorizontalAlignment="Right" Foreground="#2980B9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Margin="10,20,10,10">
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewProcessInput, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Tag="Add process name (e.g. calculator)..." BorderBrush="#D5DBDB"/>
                                        <Button Grid.Column="1" Content="Add Process" Command="{Binding AddProcessCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Width="130"/>
                                    </Grid>

                                    <Border BorderBrush="#F2F4F4" BorderThickness="1" CornerRadius="4" Background="#FAFAFA">
                                        <StackPanel>
                                            <TextBox Margin="1" Padding="10,5" BorderThickness="0,0,0,1" BorderBrush="#F2F4F4" Background="White" Text="{Binding ProcessesSearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Filter processes..."/>
                                            <ListBox ItemsSource="{Binding FilteredProcesses}" MaxHeight="150" BorderThickness="0" Background="Transparent" Padding="5">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="5,2">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
                                                            <Button Grid.Column="1" Content="Remove" Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="11"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- Create Job Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsCreateJobVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect><DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.3" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="Create New Backup Job" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <Button Content="✕" Command="{Binding CloseCreateJobCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#95A5A6" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="Job Name" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,20"/>
                    <TextBlock Text="Source Directory" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                        <Button Grid.Column="1" Content="📁" Command="{Binding BrowseSourceCommand}" Background="#F4F7F9" BorderBrush="#D5DBDB" Width="40" Margin="5,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Target Directory" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                        <Button Grid.Column="1" Content="📁" Command="{Binding BrowseTargetCommand}" Background="#F4F7F9" BorderBrush="#D5DBDB" Width="40" Margin="5,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Backup Type" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource BackupTypeEnum}}" SelectedItem="{Binding SelectedType}" Height="40" Margin="0,0,0,30"/>
                    <Button Content="Create Backup Job" Command="{Binding CreateJobCommand}" Style="{StaticResource ActionButtonStyle}" Height="45" FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>