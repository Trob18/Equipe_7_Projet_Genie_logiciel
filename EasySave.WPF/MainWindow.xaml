<Window x:Class="EasySave.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasySave.WPF"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:EasySave.WPF.Enumerations"
        mc:Ignorable="d"
        Title="EasySave v3.0" Height="750" Width="1050"
        Icon="app_icon.ico"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7F9">

    <Window.Resources>
        <!-- Enumerations -->
        <ObjectDataProvider x:Key="BackupTypeEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:BackupType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="LanguageEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Language"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Styles -->
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#34495E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2980B9"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Tag" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1F618D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#F39C12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E67E22"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#E5E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SettingsTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>

        <Style x:Key="SettingsDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#7F8C8D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Modern Input Styles -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#D5DBDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#ABB2B9"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter Property="BorderBrush" Value="#2980B9"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="Root" Background="Transparent" Cursor="Hand">
                            <Border x:Name="Background" Width="44" Height="22" Background="#BDC3C7" CornerRadius="11">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="#2ECC71"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Border CornerRadius="4" Background="#F0F3F4"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="thumbBorder" Background="#BDC3C7" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#2980B9"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="true">
                                                        <Setter TargetName="thumbBorder" Property="Background" Value="#1F618D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="#2C3E50">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="25,40,25,40" Orientation="Horizontal">
                <TextBlock Text="🛡️" Foreground="White" FontSize="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="EasySave" Foreground="White" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <RadioButton Content="{Binding Labels[TabHome]}" Style="{StaticResource SidebarButtonStyle}" 
                             IsChecked="True" x:Name="BackupsNavBtn"/>
                <RadioButton Content="{Binding Labels[TabSettings]}" Style="{StaticResource SidebarButtonStyle}"
                             x:Name="SettingsNavBtn"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="v3.0.0" Foreground="#7F8C8D" Margin="25" FontSize="10"/>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F4F7F9" BorderThickness="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SettingsNavBtn}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DarkMode}" Value="True">
                                <Setter Property="Background" Value="#121212"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="25,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding Labels[Delete]}" Command="{Binding DeleteJobCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,10,0" Padding="15,5"/>
                        <Button Content="{Binding Labels[Modify]}" Command="{Binding OpenEditJobCommand}" Style="{StaticResource WarningButtonStyle}" Margin="0,0,10,0" Padding="15,5"/>
                        <Button Content="{Binding Labels[Create]}" Command="{Binding OpenCreateJobCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,50,0" Padding="15,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Backups View -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=BackupsNavBtn}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#EAECEE" CornerRadius="12" Padding="5" BorderBrush="#ABB2B9" BorderThickness="1.5" MaxHeight="540" VerticalAlignment="Top">
                    <DataGrid x:Name="JobsDataGrid" ItemsSource="{Binding BackupJobs}" SelectedItem="{Binding SelectedJob}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="DataGrid_SelectionChanged"
                              BorderThickness="0" Background="Transparent" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="70"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.ScrollUnit="Pixel">
                    <DataGrid.Resources>
                        <!-- Fix Header Binding: Header must be a visual element or use binding proxy if RelativeSource fails in some WPF versions, 
                             but here Template is better for dynamic refresh -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#95A5A6"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#ECF0F1"/>
                            <Setter Property="Height" Value="40"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="BorderBrush" Value="#ECF0F1"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridRow">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="8" 
                                                SnapsToDevicePixels="True">
                                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#D5DBDB"/>
                                    <Setter Property="BorderBrush" Value="#ABB2B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.Labels[JobName], RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#2C3E50" FontSize="14"/>
                                        <TextBlock Text="{Binding TranslatedState}" FontSize="10" Foreground="#2980B9" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.Labels[Directories], RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <StackPanel Orientation="Horizontal" Width="100">
                                                <TextBlock Text="📁 " FontSize="10" Foreground="#95A5A6"/>
                                                <TextBlock Text="{Binding DataContext.Labels[SourcePath], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="#95A5A6"/>
                                                <TextBlock Text=":" FontSize="10" Foreground="#95A5A6"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="350">
                                                <Hyperlink Click="OpenDirectory_Click" CommandParameter="{Binding SourceDirectory}"
                                                           Foreground="#2980B9" TextDecorations="None">
                                                    <TextBlock Text="{Binding ShortSourceDirectory}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Horizontal" Width="100">
                                                <TextBlock Text="🎯 " FontSize="10" Foreground="#95A5A6"/>
                                                <TextBlock Text="{Binding DataContext.Labels[TargetPath], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="10" Foreground="#95A5A6"/>
                                                <TextBlock Text=":" FontSize="10" Foreground="#95A5A6"/>
                                            </StackPanel>
                                            <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="350">
                                                <Hyperlink Click="OpenDirectory_Click" CommandParameter="{Binding TargetDirectory}"
                                                           Foreground="#2980B9" TextDecorations="None">
                                                    <TextBlock Text="{Binding ShortTargetDirectory}"/>
                                                </Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.Labels[Throughput], RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ThroughputText}" VerticalAlignment="Center" FontSize="11" Foreground="#2980B9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="140">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.Labels[Transfer], RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeProgressText}" VerticalAlignment="Center" FontSize="11" Foreground="#5D6D7E" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="150">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.Labels[Progress], RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" Margin="10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <ProgressBar Value="{Binding Progress}" Grid.Row="1" Height="8" Background="#ECF0F1" BorderThickness="0">
                                            <ProgressBar.Foreground>
                                                <SolidColorBrush Color="#2980B9"/>
                                            </ProgressBar.Foreground>
                                        </ProgressBar>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="{Binding DataContext.Labels[Type], RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EBEDEF" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TranslatedType}" FontSize="11" FontWeight="SemiBold" Foreground="#5D6D7E"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Border>

                <!-- Floating Control Bubble -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20" 
                        Background="White" CornerRadius="30" Padding="10" BorderBrush="#ECF0F1" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.15" ShadowDepth="4" Direction="270"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="▶" Command="{Binding ExecuteOrResumeJobCommand}" Style="{StaticResource ActionButtonStyle}" Width="150" Height="45" Margin="5,0" Tag="22.5" FontSize="14"/>
                        <Button Content="❚❚" Command="{Binding PauseJobCommand}" Style="{StaticResource ActionButtonStyle}" Width="45" Height="45" Margin="5,0" ToolTip="Pause" Tag="22.5"/>
                        <Button Content="◼" Command="{Binding StopJobCommand}" Style="{StaticResource DangerButtonStyle}" Width="45" Height="45" Margin="5,0" ToolTip="Stop" Tag="22.5"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Settings View -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=SettingsNavBtn}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                        
                        <Grid Margin="0,0,0,30">
                            <TextBlock Text="{Binding Labels[TabSettings]}" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
                        </Grid>

                        <!-- Section: Interface & Logs -->
                        <TextBlock Text="⚙️ GÉNÉRAL &amp; LOGS" Foreground="#95A5A6" FontWeight="Bold" FontSize="11" Margin="5,0,0,10"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Labels[LangInterface]}" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="{Binding Labels[LangInterfaceDesc]}" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding Source={StaticResource LanguageEnum}}" SelectedItem="{Binding SelectedLanguage}"/>
                                </Grid>
                                
                                <Separator Background="#F2F4F4" Margin="0,5,0,20"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Labels[LogFormat]}" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="{Binding Labels[LogFormatDesc]}" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding LogFormats}" SelectedItem="{Binding SelectedLogFormat}"/>
                                </Grid>

                                <Separator Background="#F2F4F4" Margin="0,5,0,20"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Labels[LogServerIP]}" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="{Binding Labels[LogServerIPDesc]}" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="200" Text="{Binding LogServerIP, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                                </Grid>

                                <Separator Background="#F2F4F4" Margin="0,0,0,20"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Labels[MaxLargeFileSizeMO]}" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="{Binding Labels[MaxLargeFileSizeMODesc]}" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="180" Height="32" VerticalContentAlignment="Center" Padding="8,0" Text="{Binding MaxLargeFileSizeMO, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Chiffrement -->
                        <TextBlock Text="🔒 SÉCURITÉ &amp; CHIFFREMENT" Foreground="#95A5A6" FontWeight="Bold" FontSize="11" Margin="5,15,0,10"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Labels[EncryptAll]}" Style="{StaticResource SettingsTitleStyle}"/>
                                        <TextBlock Text="{Binding Labels[EncryptAllDesc]}" Style="{StaticResource SettingsDescStyle}"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding EncryptAll}" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center"/>
                                </Grid>

                                <Expander Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                                    <Expander.Style>
                                        <Style TargetType="Expander">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EncryptAll}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Expander.Style>
                                    <Expander.Header>
                                        <Grid Width="700">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📜" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Labels[EncryptExtensions]}" VerticalAlignment="Center" Style="{StaticResource SettingsTitleStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding EncryptedExtensionsList.Count}" HorizontalAlignment="Right" Foreground="#2980B9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,30,0"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="10,20,10,10">
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="ExtInput" Text="{Binding NewExtensionInput, UpdateSourceTrigger=PropertyChanged}" Tag="Ajouter .txt, .pdf..."/>
                                            <Button Grid.Column="1" Content="{Binding Labels[AddExtension]}" Command="{Binding AddExtensionCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Width="100" Height="38"/>
                                        </Grid>
                                        <Border BorderBrush="#F2F4F4" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                            <ListBox ItemsSource="{Binding FilteredExtensions}" MaxHeight="180" BorderThickness="0" Background="Transparent" Padding="5" VirtualizingStackPanel.ScrollUnit="Pixel">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="5,4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
                                                            <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,2"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Section: Contrôle & Priorités -->
                        <TextBlock Text="🚀 CONTRÔLE &amp; PERFORMANCE" Foreground="#95A5A6" FontWeight="Bold" FontSize="11" Margin="5,15,0,10"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Expander Background="Transparent" BorderThickness="0">
                                    <Expander.Header>
                                        <Grid Width="700">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🚫" FontSize="18" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Labels[BlockedProcesses]}" Style="{StaticResource SettingsTitleStyle}"/>
                                                    <TextBlock Text="{Binding Labels[BlockedProcessesDesc]}" Style="{StaticResource SettingsDescStyle}" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding BlockedProcessesList.Count}" HorizontalAlignment="Right" Foreground="#2980B9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,30,0"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="10,20,10,10">
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewProcessInput, UpdateSourceTrigger=PropertyChanged}" Tag="Nom du processus..."/>
                                            <Button Grid.Column="1" Content="{Binding Labels[AddProcess]}" Command="{Binding AddProcessCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Width="100" Height="38"/>
                                        </Grid>
                                        <Border BorderBrush="#F2F4F4" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                            <ListBox ItemsSource="{Binding FilteredProcesses}" MaxHeight="180" BorderThickness="0" Background="Transparent" Padding="5" VirtualizingStackPanel.ScrollUnit="Pixel">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="5,4">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
                                                            <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.RemoveProcessCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,2"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>
                                </Expander>

                                <Separator Background="#F2F4F4" Margin="0,15,0,15"/>

                                <Expander Background="Transparent" BorderThickness="0">
                                    <Expander.Header>
                                        <Grid Width="700">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⚡" FontSize="22" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#F1C40F"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Labels[PriorityExtensions]}" Style="{StaticResource SettingsTitleStyle}"/>
                                                    <TextBlock Text="{Binding Labels[PriorityExtensionsDesc]}" Style="{StaticResource SettingsDescStyle}" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PriorityExtensionsList.Count}" HorizontalAlignment="Right" Foreground="#2980B9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,30,0"/>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Margin="10,20,10,10">
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewPriorityExtensionInput, UpdateSourceTrigger=PropertyChanged}" Tag="Extensions prioritaires..."/>
                                            <Button Grid.Column="1" Content="{Binding Labels[AddExtension]}" Command="{Binding AddPriorityExtensionCommand}" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Width="100" Height="38"/>
                                        </Grid>
                                        <Border BorderBrush="#F2F4F4" BorderThickness="1" CornerRadius="6" Background="#FAFAFA">
                                            <ListBox ItemsSource="{Binding FilteredPriorityExtensions}" MaxHeight="180" BorderThickness="0" Background="Transparent" Padding="5" VirtualizingStackPanel.ScrollUnit="Pixel">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="5,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button Content="↑" Command="{Binding DataContext.MovePriorityExtensionUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#2980B9" Background="Transparent" BorderThickness="0" Width="30" FontSize="14" Cursor="Hand"/>
                                                                <Button Content="↓" Command="{Binding DataContext.MovePriorityExtensionDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#2980B9" Background="Transparent" BorderThickness="0" Width="30" FontSize="14" Cursor="Hand"/>
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="✕" Command="{Binding DataContext.RemovePriorityExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Foreground="#E74C3C" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="10,2"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Height="50"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </Grid>

        <!-- Create Job Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsCreateJobVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect><DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.3" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="{Binding Labels[Create]}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <Button Content="✕" Command="{Binding CloseCreateJobCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#95A5A6" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="{Binding Labels[JobName]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding Labels[SourcePath]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                        <Button Grid.Column="1" Content="📁" Command="{Binding BrowseSourceCommand}" Background="#F4F7F9" BorderBrush="#D5DBDB" Width="40" Margin="5,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Labels[TargetPath]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                        <Button Grid.Column="1" Content="📁" Command="{Binding BrowseTargetCommand}" Background="#F4F7F9" BorderBrush="#D5DBDB" Width="40" Margin="5,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Labels[Type]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource BackupTypeEnum}}" SelectedItem="{Binding SelectedType}" Height="40" Margin="0,0,0,30"/>
                    <Button Content="{Binding Labels[Create]}" Command="{Binding CreateJobCommand}" Style="{StaticResource ActionButtonStyle}" Height="45" FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit Job Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80000000" Visibility="{Binding IsEditJobVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <Border.Effect><DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.3" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <TextBlock Text="{Binding Labels[Modify]}" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                        <Button Content="✕" Command="{Binding CloseEditJobCommand}" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" FontSize="18" Foreground="#95A5A6" Cursor="Hand"/>
                    </Grid>
                    <TextBlock Text="{Binding Labels[JobName]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding JobName, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" Margin="0,0,0,20"/>
                    <TextBlock Text="{Binding Labels[SourcePath]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                        <Button Grid.Column="1" Content="📁" Command="{Binding BrowseSourceCommand}" Background="#F4F7F9" BorderBrush="#D5DBDB" Width="40" Margin="5,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Labels[TargetPath]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" Padding="10,8"/>
                        <Button Grid.Column="1" Content="📁" Command="{Binding BrowseTargetCommand}" Background="#F4F7F9" BorderBrush="#D5DBDB" Width="40" Margin="5,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Labels[Type]}" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource BackupTypeEnum}}" SelectedItem="{Binding SelectedType}" Height="40" Margin="0,0,0,30"/>
                    <Button Content="{Binding Labels[Update]}" Command="{Binding UpdateJobCommand}" Style="{StaticResource ActionButtonStyle}" Height="45" FontSize="15"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>